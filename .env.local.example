# StockPilot AI — Environment Variables Example
# Copy this file to .env.local and fill in your values

# ─── NextAuth ───────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# The canonical URL of your app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
# From: https://supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Database (Prisma) ───────────────────────────────────────────────────────
# From: https://supabase.com → Project → Settings → Database → Connection string
# Use the "URI" format with ?pgbouncer=true for production
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# From: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
